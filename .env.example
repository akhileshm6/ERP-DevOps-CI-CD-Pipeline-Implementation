# ERP DevOps CI/CD Pipeline — environment template
# Copy to .env and fill in real values.  .env is gitignored; never commit it.
#   cp .env.example .env

# ---- Postgres (compose `db` service) ----
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=CHANGE_ME_local_only
POSTGRES_DB=erp_db

# ---- Host port mappings (change only if a port is already in use) ----
# If you have a native Postgres installed it already owns 5432 and the
# container's mapping will be shadowed by it. Use 5544 in that case.
DB_PORT=5432
SERVER_PORT=5000
CLIENT_PORT=3000

# ---- API (compose `server` service) ----
NODE_ENV=development
PORT=5000
DATABASE_URL=postgres://erp_user:CHANGE_ME_local_only@db:5432/erp_db
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Release traceability (injected by CI; harmless defaults locally) ----
APP_VERSION=dev
COMMIT_SHA=local
GIT_BRANCH=local
# ISO timestamp of the image build; leave unset locally (reported as unknown).
# BUILD_TIMESTAMP=

# ---- CI → API deployment records ----
# Shared secret CI sends as X-Deploy-Token to POST /api/deployments.
# Required in staging/production (writes are refused without it).
DEPLOY_API_TOKEN=CHANGE_ME_generate_with_openssl_rand_hex_32

# ---- Data and startup behaviour ----
# Apply pending server/db/*.sql migrations on startup (Postgres only).
MIGRATE_ON_START=true
# Seed generated sample data into EMPTY tables on first start. Set false for real data.
SEED_DEMO_DATA=true
# Create demo logins (admin@/manager@/user@erp.local). Ignored in production
# unless explicitly set to true — the passwords are published in the README.
SEED_DEMO_USERS=true
# memory = no database at all (data lost on restart). Default: postgres.
# DATA_STORE=memory
# Never set in normal operation; bypasses the additive-migration check.
# ALLOW_DESTRUCTIVE_MIGRATIONS=false
