# ERP DevOps CI/CD Pipeline — environment template
# Copy to .env and fill in real values.  .env is gitignored; never commit it.
#   cp .env.example .env

# ---- Postgres (compose `db` service) ----
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=CHANGE_ME_local_only
POSTGRES_DB=erp_db

# ---- Host port mappings (change only if a port is already in use) ----
DB_PORT=5432
SERVER_PORT=5000
CLIENT_PORT=3000

# ---- API (compose `server` service) ----
NODE_ENV=development
PORT=5000
DATABASE_URL=postgres://erp_user:CHANGE_ME_local_only@db:5432/erp_db
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Release traceability (injected by CI; harmless defaults locally) ----
APP_VERSION=dev
COMMIT_SHA=local
